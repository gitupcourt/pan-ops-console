# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# Where the SQLite database lives. For docker-compose, this is inside the data volume.
DATABASE_URL=sqlite:///data/capacity.db

# How often the poller runs, in seconds.
POLL_INTERVAL_SECONDS=300

# Path to the metric catalog YAML.
CATALOG_PATH=/app/catalog/metrics.yaml

# CORS — comma-separated list of frontend origins.
CORS_ORIGINS=http://localhost:5173
