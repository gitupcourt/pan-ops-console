# Required. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Encrypts firewall/Panorama API keys at rest in SQLite. Losing this makes
# existing stored credentials unrecoverable.
FERNET_KEY=

# Optional overrides. The defaults inside docker-compose.yml work for a
# single-host install; only set these if you're deploying differently.
# DATABASE_URL=sqlite:///data/capacity.db
# CATALOG_PATH=/app/catalog/metrics.yaml
# POLL_INTERVAL_SECONDS=300
# CORS_ORIGINS=http://localhost:5174
