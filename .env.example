# Copy to .env and fill in real values. Never commit .env.

# ---------- Database ----------
POSTGRES_USER=panfw
POSTGRES_PASSWORD=changeme_postgres
POSTGRES_DB=panfw
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ---------- Redis (Celery broker / result backend) ----------
REDIS_HOST=redis
REDIS_PORT=6379

# ---------- Backend / API ----------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change_me_to_a_random_48_byte_secret

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Used to encrypt firewall/Panorama credentials at rest.
FERNET_KEY=change_me_to_a_fernet_key

# JWT lifetime (minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Initial admin user (created on first run if no users exist)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=changeme_admin

# CORS origins for the frontend (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---------- Frontend ----------
VITE_API_BASE_URL=http://localhost:8000

# ---------- Email (optional, for reports / notifications) ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=panfw-upgrader@example.com
SMTP_TLS=true

# ---------- Image storage ----------
# Local path (inside containers) where uploaded PAN-OS images are stored
IMAGE_STORAGE_PATH=/var/lib/panfw/images

# ---------- Scheduled refresh ----------
# How often the background worker pulls fresh device data from every Panorama.
PANORAMA_REFRESH_INTERVAL_MINUTES=15
