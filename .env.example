# =============================================================================
# pan-capacity-analyzer environment
#
# SECURITY NOTES — read these before generating a FERNET_KEY.
#
# 1.  FERNET_KEY encrypts every firewall / Panorama API credential the app
#     stores. Anyone who has this key can decrypt those tokens and use them
#     against your firewalls. Treat it like a private TLS key, not like an
#     API token.
#
# 2.  Generate it ONCE and back the value up to a password manager
#     (1Password, Bitwarden, pass, etc.) immediately. If you lose the value
#     after entering device credentials, those stored credentials become
#     unrecoverable and you'll have to re-enter every device by hand.
#
# 3.  `.env` is gitignored (verify with `git check-ignore -v .env`). Do not
#     commit, paste, or screenshot this file. The key looks innocuous; it
#     isn't.
#
# 4.  Lock down the file:
#         chmod 600 .env
#     so only the owning user can read it.
#
# 5.  DO NOT regenerate the key after devices have been added — same trap
#     as #2. If you must rotate, decrypt all stored creds with the old key
#     first, then re-encrypt with the new one.
#
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print('FERNET_KEY=' + Fernet.generate_key().decode())" >> .env
# =============================================================================

FERNET_KEY=

# Optional overrides. The defaults inside docker-compose.yml work for a
# single-host install; only set these if you're deploying differently.
# DATABASE_URL=sqlite:///data/capacity.db
# CATALOG_PATH=/app/catalog/metrics.yaml
# POLL_INTERVAL_SECONDS=300
# CORS_ORIGINS=http://localhost:5174
