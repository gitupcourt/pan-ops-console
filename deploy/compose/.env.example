# Copy to .env and fill in. `docker compose` reads .env automatically.

# Postgres password — any value. Used by the postgres service and DATABASE_URL.
POSTGRES_PASSWORD=change-me

# Encryption key for stored firewall/Panorama credentials (REQUIRED — the
# backend won't start without it). Generate one with NO local dependencies:
#
#   openssl rand -base64 32 | tr '+/' '-_'
#
# (or, once images are built:  docker compose run --rm backend \
#    python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
#
# WARNING: never change this on an existing install — it makes every stored
# credential, TOTP secret, and OIDC client secret unrecoverable. Back it up.
FERNET_KEY=
